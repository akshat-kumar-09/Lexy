# Copy to .env.local and fill in real values. Never commit .env.local.

# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Neon Postgres — pooled connection string (Dashboard → Connect)
# Run scripts/neon-schema.sql once in the Neon SQL editor.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Encrypt OpenAI keys at rest in Postgres (32+ chars). Required in production when DATABASE_URL is set.
OPENAI_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional: Google Form, Typeform, or GitHub issue URL for “Your voice is valued” feedback.
# If unset, the app uses mailto with the user’s email client.
# NEXT_PUBLIC_FEEDBACK_URL=https://forms.gle/your-form
